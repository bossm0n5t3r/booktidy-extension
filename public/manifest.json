{
  "manifest_version": 3,
  "name": "BookTidy",
  "version": "1.0.0",
  "description": "Collapse matching book listings based on user-defined publisher or author rules.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://*.kyobobook.co.kr/*"],
  "web_accessible_resources": [
    {
      "resources": ["booktidy-icon.svg"],
      "matches": ["*://*.kyobobook.co.kr/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "booktidy@bossm0n5t3r.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "action": {
    "default_title": "BookTidy",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "48": "booktidy-icon.svg"
    }
  },
  "icons": {
    "48": "booktidy-icon.svg",
    "96": "booktidy-icon.svg"
  },
  "background": {
    "scripts": ["assets/background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.kyobobook.co.kr/*"],
      "js": ["assets/content.js"],
      "css": ["assets/content.css"],
      "run_at": "document_idle"
    }
  ]
}
